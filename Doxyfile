#---------------------------------------------------------------------------
# Project configuration
#---------------------------------------------------------------------------
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "embedded-project"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "STM32 Nucleo-C031C6 telemetry stream and FSM firmware"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
OPTIMIZE_OUTPUT_FOR_C  = YES

#---------------------------------------------------------------------------
# Extraction & Scope configuration
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES

#---------------------------------------------------------------------------
# Input files & Directories
#---------------------------------------------------------------------------
INPUT                  = Core/Inc Core/Src README.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.pio/* \
                         */Drivers/* \
                         */test/*
USE_MDFILE_AS_MAINPAGE = README.md

#---------------------------------------------------------------------------
# Source Browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# HTML Output configuration
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# Disable unneeded formats
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

#---------------------------------------------------------------------------
# Preprocessor configuration
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = Core/Inc Core/Inc/recruiting
PREDEFINED             = 

#---------------------------------------------------------------------------
# Diagram / Dot configuration
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES